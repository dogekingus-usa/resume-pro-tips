---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/10-mistakes-that-make-your-resume-look-dated-2026-edition.html?raw';

const title = "10 Mistakes That Make Your Resume Look Dated (2026 Edition) | resumeprotips.com";
const description = "Introduction Welcome to Resumeprotips.com, where we help job seekers create standout resumes that catch the eye of hiring managers in 2026. In this post, we\u0027ll";
const canonical = "https://resumeprotips.com/10-mistakes-that-make-your-resume-look-dated-2026-edition";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>