---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/10-resume-mistakes-that-instantly-get-you-rejected-by-recruiters.html?raw';

const title = "10 Resume Mistakes That Instantly Get You Rejected by Recruiters | resumeprotips.com";
const description = "Creating an impressive resume is crucial in today\u0027s competitive job market. However, many job seekers make common mistakes that can instantly get their applica";
const canonical = "https://resumeprotips.com/10-resume-mistakes-that-instantly-get-you-rejected-by-recruiters";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>