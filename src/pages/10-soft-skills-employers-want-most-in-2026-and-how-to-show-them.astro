---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/10-soft-skills-employers-want-most-in-2026-and-how-to-show-them.html?raw';

const title = "10 Soft Skills Employers Want Most in 2026 and How to Show Them | resumeprotips.com";
const description = "10 Soft Skills Employers Want Most in 2026 and How to Show Them 10 Soft Skills Employers Want Most in 2026 and How to Show Them In today\u0027s";
const canonical = "https://resumeprotips.com/10-soft-skills-employers-want-most-in-2026-and-how-to-show-them";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>