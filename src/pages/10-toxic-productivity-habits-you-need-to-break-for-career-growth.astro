---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/10-toxic-productivity-habits-you-need-to-break-for-career-growth.html?raw';

const title = "10 Toxic Productivity Habits You Need to Break for Career Growth | resumeprotips.com";
const description = "Are you struggling to advance in your career despite putting in long hours? You might be unknowingly adopting productivity habits that are counterproductive, h";
const canonical = "https://resumeprotips.com/10-toxic-productivity-habits-you-need-to-break-for-career-growth";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>