---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/11-resume-keywords-that-get-past-ats-systems-2026.html?raw';

const title = "11 Resume Keywords That Get Past ATS Systems in 2026 | ResumeProTips.com";
const description = "Discover the 11 most effective resume keywords that bypass ATS filters in 2026. Industry-specific terms, power words, and strategic placement tips to get your resume seen by real recruiters.";
const canonical = "https://resumeprotips.com/11-resume-keywords-that-get-past-ats-systems-2026";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>