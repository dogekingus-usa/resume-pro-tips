---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/15-high-impact-resume-action-verbs-that-recruiters-love.html?raw';

const title = "15 High-Impact Resume Action Verbs That Recruiters Love | resumeprotips.com";
const description = "Looking to impress recruiters with your resume? Choosing the right action verbs can make all the difference in catching their attention. Here are 15 high-impac";
const canonical = "https://resumeprotips.com/15-high-impact-resume-action-verbs-that-recruiters-love";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>