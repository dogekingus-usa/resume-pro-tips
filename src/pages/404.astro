---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/404.html?raw';

const title = "404 — Page Not Found | Resume Pro Tips";
const description = "Page not found on Resume Pro Tips — browse our full article library instead.";
const canonical = "https://resumeprotips.com/404.html";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
  </div>
</BaseLayout>