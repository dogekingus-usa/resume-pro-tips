---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/about.html?raw';

const title = "About Resume Pro Tips  — Land Your Dream Job";
const description = "Resume Pro Tips helps you craft resumes and cover letters that get noticed by recruiters and hiring managers.";
const canonical = "https://resumeprotips.com/about.html";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
  </div>
</BaseLayout>