---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/all-articles.html?raw';

const title = "All Articles  — Resume Pro Tips";
const description = "Browse all 402 articles on Resume Pro Tips";
const canonical = "https://resumeprotips.com/all-articles";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
  </div>
</BaseLayout>