---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/article2-psychology-of-hiring.html?raw';

const title = "The Psychology of Hiring: What Recruiters See in the First 6 Seconds of Your Resume | Resume Pro Tips";
const description = "Discover the neuroscience behind resume screening. Learn what recruiters see in the first 6 seconds and how to design your resume to capture attention instantly in 2026.";
const canonical = "https://resumeprotips.com/article2-psychology-of-hiring";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>