---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/article3-creative-resume-portfolio.html?raw';

const title = "How to Build a Resume Portfolio for Creative and Design Roles in 2026 | Resume Pro Tips";
const description = "Learn how to create a compelling resume portfolio for creative and design roles in 2026. Tips on showcasing visual work, writing case studies, and balancing aesthetics with ATS requirements.";
const canonical = "https://resumeprotips.com/article3-creative-resume-portfolio";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>