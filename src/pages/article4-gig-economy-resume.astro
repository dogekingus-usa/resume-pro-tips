---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/article4-gig-economy-resume.html?raw';

const title = "Resume Writing for the Gig Economy: How to Showcase Freelance and Contract Work | Resume Pro Tips";
const description = "Master the art of writing a resume for the gig economy. Learn how to showcase freelance projects, contract roles, and multiple clients effectively on your resume in 2026.";
const canonical = "https://resumeprotips.com/article4-gig-economy-resume";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>