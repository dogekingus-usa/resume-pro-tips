---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/ats-optimized-resume-templates-kit.html?raw';

const title = "ATS-Optimized Resume Templates: How the Right Kit Gets You More Interviews | ResumeProTips.com";
const description = "ATS-optimized resume templates can 3x your interview chances. Learn how the right resume kit helps you pass automated screening and get noticed by recruiters.";
const canonical = "https://resumeprotips.com/ats-optimized-resume-templates-kit";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>