---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/ats-resume-checker-tools.html?raw';

const title = "Best ATS Resume Checker Tools 2026: Features, Pricing \u0026 How to Use Results";
const description = "Compare the top ATS resume checker tools for 2026: Jobscan, TopResume, Resume Worded, SkillSyncer, and Unstop. Features comparison, pricing, ATS simulation scores, and how to use results to improve your resume.";
const canonical = "https://resumeprotips.com/ats-resume-checker-tools";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>