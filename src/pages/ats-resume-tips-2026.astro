---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/ats-resume-tips-2026.html?raw';

const title = "ATS Resume Tips 2026: How to Optimize Your Resume for Applicant Tracking Systems";
const description = "Learn how to optimize your resume for ATS in 2026. Discover keyword strategies, formatting tips, and the best file types to beat applicant tracking systems and land more interviews.";
const canonical = "https://resumeprotips.com/ats-resume-tips-2026";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>