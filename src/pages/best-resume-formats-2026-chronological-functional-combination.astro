---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/best-resume-formats-2026-chronological-functional-combination.html?raw';

const title = "Best Resume Formats for 2026: Chronological, Functional, or Combination — | ResumeProTips.com";
const description = "Not sure which resume format to use in 2026? Compare chronological, functional, and combination resume formats. Find the right structure for your career stage and goals.";
const canonical = "https://resumeprotips.com/best-resume-formats-2026-chronological-functional-combination";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>