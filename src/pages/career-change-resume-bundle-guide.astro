---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/career-change-resume-bundle-guide.html?raw';

const title = "Career Change Resume Bundle: Templates, Keywords, and Strategies for Switching Industries Seamlessly | ResumeProTips.com";
const description = "Switching careers in 2026? This career change resume bundle review shows how specialized templates and industry keywords help you pivot industries without starting from scratch.";
const canonical = "https://resumeprotips.com/career-change-resume-bundle-guide";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>