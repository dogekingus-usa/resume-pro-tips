---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/career-pivot-resume-no-direct-experience.html?raw';

const title = "How to Write a Career Pivot Resume When You Have No Direct Experience | Resume Pro Tips";
const description = "Complete guide to writing a career pivot resume when you have no direct experience in your target field. Learn how to frame transferable skills, use a hybrid format, and get interviews.";
const canonical = "https://resumeprotips.com/career-pivot-resume-no-direct-experience";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>