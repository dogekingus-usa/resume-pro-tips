---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/checkout.html?raw';

const title = "Checkout  — Resume Pro Tips";
const description = "Complete your purchase of premium digital products from Resume Pro Tips.";
const canonical = "https://resumeprotips.com/checkout";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
  </div>
</BaseLayout>