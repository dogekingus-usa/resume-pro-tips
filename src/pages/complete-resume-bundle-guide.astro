---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/complete-resume-bundle-guide.html?raw';

const title = "The Complete Resume Bundle: Why You Need Templates, Examples, and More | ResumeProTips.com";
const description = "Discover why a complete resume bundle beats a single template. Get resume templates, cover letter examples, ATS checklists, and job search guides in one comprehensive package.";
const canonical = "https://resumeprotips.com/complete-resume-bundle-guide";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>