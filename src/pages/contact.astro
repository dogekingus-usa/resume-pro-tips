---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/contact.html?raw';

const title = "Contact Us  — Resume Pro Tips";
const description = "Get in touch with Resume Pro Tips. Have a question about your resume or want to suggest a topic? We would love to hear from you.";
const canonical = "https://resumeprotips.com/contact";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
  </div>
</BaseLayout>