---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/employment-gap-resume-2026.html?raw';

const title = "Employment Gap on Resume 2026: How to Explain Career Breaks \u0026 Get Hired | ResumeProTips.com";
const description = "Learn how to explain employment gaps and career breaks on your resume in 2026. Complete guide with resume examples, formatting strategies, and interview tips.";
const canonical = "https://resumeprotips.com/employment-gap-resume-2026";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>