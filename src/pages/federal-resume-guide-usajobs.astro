---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/federal-resume-guide-usajobs.html?raw';

const title = "The Complete USAJOBS Federal Resume Guide: Format, KSAs, GS Levels, and Key Strategies";
const description = "Master the USAJOBS federal resume format. Step-by-step guide covering KSAs, questionnaire responses, GS levels, veteran preference, Schedule A, and keyword optimization with a sample federal resume section.";
const canonical = "https://resumeprotips.com/federal-resume-guide-usajobs";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>