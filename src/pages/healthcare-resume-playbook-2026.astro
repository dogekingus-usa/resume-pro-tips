---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/healthcare-resume-playbook-2026.html?raw';

const title = "Healthcare Resume Playbook: ATS Keywords, Certifications \u0026 Patient Impact Metrics That Land Interviews in 2026";
const description = "Master healthcare resume writing with specialty-specific ATS keywords, certification strategies for physicians, nurses \u0026 allied health pros, and patient impact metrics that hiring managers actively search for in 2026.";
const canonical = "https://resumeprotips.com/healthcare-resume-playbook-2026";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>