---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/how-to-explain-short-term-jobs-on-your-resume-without-red-flags.html?raw';

const title = "How to Explain Short-Term Jobs on Your Resume Without Red Flags | resumeprotips.com";
const description = "When discussing your work history on a resume, it\u0027s crucial to handle short-term jobs carefully to avoid raising any red flags or giving potential employers re";
const canonical = "https://resumeprotips.com/how-to-explain-short-term-jobs-on-your-resume-without-red-flags";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>