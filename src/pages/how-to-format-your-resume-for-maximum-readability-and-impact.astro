---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/how-to-format-your-resume-for-maximum-readability-and-impact.html?raw';

const title = "How to Format Your Resume for Maximum Readability and Impact | resumeprotips.com";
const description = "Formatting your resume is essential to ensure that it stands out from other applications and captures the attention of potential employers. By focusing on read";
const canonical = "https://resumeprotips.com/how-to-format-your-resume-for-maximum-readability-and-impact";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>