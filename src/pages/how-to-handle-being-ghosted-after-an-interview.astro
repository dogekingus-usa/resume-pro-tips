---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/how-to-handle-being-ghosted-after-an-interview.html?raw';

const title = "How to Handle Being Ghosted After an Interview | resumeprotips.com";
const description = "How to Handle Being Ghosted After an Interview If you\u0027ve ever experienced the frustration of being ghosted after an interview, you know how unsettling it can b";
const canonical = "https://resumeprotips.com/how-to-handle-being-ghosted-after-an-interview";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>