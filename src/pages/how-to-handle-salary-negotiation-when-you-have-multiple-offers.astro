---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/how-to-handle-salary-negotiation-when-you-have-multiple-offers.html?raw';

const title = "How to Handle Salary Negotiation When You Have Multiple Offers | resumeprotips.com";
const description = "Handling salary negotiations can be a challenging but crucial aspect of accepting an offer. When you have multiple job offers, each with its own salary range,";
const canonical = "https://resumeprotips.com/how-to-handle-salary-negotiation-when-you-have-multiple-offers";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>