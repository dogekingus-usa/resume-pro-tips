---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/how-to-list-side-projects-on-your-resume-the-right-way.html?raw';

const title = "How to List Side Projects on Your Resume the Right Way | resumeprotips.com";
const description = "Adding side projects to your resume can be an excellent way to showcase additional skills and experiences that aren\u0027t directly related to your primary job role";
const canonical = "https://resumeprotips.com/how-to-list-side-projects-on-your-resume-the-right-way";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>