---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/how-to-negotiate-salary-after-job-offer.html?raw';

const title = "How to Negotiate Salary After a Job Offer | Resume Pro Tips";
const description = "Learn exactly how to negotiate salary after receiving a job offer. Step-by-step script, timing tips, and strategies to increase your offer by 10-25% without jeopardizing the deal.";
const canonical = "https://resumeprotips.com/how-to-negotiate-salary-after-job-offer.html";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>