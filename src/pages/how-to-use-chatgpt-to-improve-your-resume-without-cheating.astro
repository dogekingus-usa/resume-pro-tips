---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/how-to-use-chatgpt-to-improve-your-resume-without-cheating.html?raw';

const title = "How to Use ChatGPT to Improve Your Resume Without Cheating | resumeprotips.com";
const description = "How to Use ChatGPT to Improve Your Resume Without Cheating How to Use ChatGPT to Improve Your Resume Without Cheating Welcome to ResumeproTips,";
const canonical = "https://resumeprotips.com/how-to-use-chatgpt-to-improve-your-resume-without-cheating";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>