---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/how-to-write-a-cover-letter-that-gets-read-in-under-10-seconds.html?raw';

const title = "How to Write a Cover Letter That Gets Read in Under 10 Seconds | ResumeProTips.com";
const description = "Learn how to write a cover letter that gets read in under 10 seconds. Hook recruiters fast with proven formulas, formatting tips, and actionable templates.";
const canonical = "https://resumeprotips.com/how-to-write-a-cover-letter-that-gets-read-in-under-10-seconds";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>