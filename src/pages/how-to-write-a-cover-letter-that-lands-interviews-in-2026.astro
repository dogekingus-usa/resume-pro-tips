---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/how-to-write-a-cover-letter-that-lands-interviews-in-2026.html?raw';

const title = "How to Write a Cover Letter That Lands Interviews in 2026 | resumeprotips.com";
const description = "In 2026, the job market is more competitive than ever, making your cover letter a critical tool to stand out from the crowd and land interviews. Crafting a";
const canonical = "https://resumeprotips.com/how-to-write-a-cover-letter-that-lands-interviews-in-2026";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>