---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/how-to-write-a-federal-resume-that-gets-you-a-gs-15-position.html?raw';

const title = "How to Write a Federal Resume That Gets You a GS-15 Position | resumeprotips.com";
const description = "Writing an effective federal resume is crucial to securing a GS-15 position within the U.S. government. The GS-15 classification typically requires a high leve";
const canonical = "https://resumeprotips.com/how-to-write-a-federal-resume-that-gets-you-a-gs-15-position";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>