---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/how-to-write-a-professional-summary-for-your-resume-20-examples.html?raw';

const title = "How to Write a Professional Summary for Your Resume (20+ Examples) | resumeprotips.com";
const description = "Why a Professional Summary is Essential on Your Resume A professional summary is your chance to make a powerful first impression. It serves as an introductory s";
const canonical = "https://resumeprotips.com/how-to-write-a-professional-summary-for-your-resume-20-examples";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>