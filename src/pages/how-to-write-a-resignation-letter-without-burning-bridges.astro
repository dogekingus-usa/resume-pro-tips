---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/how-to-write-a-resignation-letter-without-burning-bridges.html?raw';

const title = "How to Write a Resignation Letter Without Burning Bridges | resumeprotips.com";
const description = "Introduction to Writing a Resignation Letter Writing a resignation letter is an important step in your career journey, and it\u0027s crucial to approach this task wi";
const canonical = "https://resumeprotips.com/how-to-write-a-resignation-letter-without-burning-bridges";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>