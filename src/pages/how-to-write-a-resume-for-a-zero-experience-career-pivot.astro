---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/how-to-write-a-resume-for-a-zero-experience-career-pivot.html?raw';

const title = "How to Write a Resume for a Zero-Experience Career Pivot | resumeprotips.com";
const description = "Transitioning into a new career path without any prior experience can seem daunting. However, with strategic planning and focused effort, you can craft a compe";
const canonical = "https://resumeprotips.com/how-to-write-a-resume-for-a-zero-experience-career-pivot";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>