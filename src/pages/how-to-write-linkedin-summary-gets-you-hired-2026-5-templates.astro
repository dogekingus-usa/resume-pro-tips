---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/how-to-write-linkedin-summary-gets-you-hired-2026-5-templates.html?raw';

const title = "How to Write a LinkedIn Summary That Gets You Hired in 2026: 5 Templates | ResumeProTips.com";
const description = "Learn how to write a LinkedIn summary that gets you hired in 2026. Includes 5 proven templates for career changers, executives, entry-level job seekers, and more.";
const canonical = "https://resumeprotips.com/how-to-write-linkedin-summary-gets-you-hired-2026-5-templates";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>