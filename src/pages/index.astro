---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/index.html?raw';

const title = "Resume Pro Tips — Land Your Dream Job";
const description = "Land Your Dream Job — curated guides, tools, and systems to help you level up.";
const canonical = "https://resumeprotips.com";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
  </div>
</BaseLayout>