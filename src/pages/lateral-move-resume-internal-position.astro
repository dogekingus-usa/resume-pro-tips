---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/lateral-move-resume-internal-position.html?raw';

const title = "How to Write a Resume for a Lateral Move: Internal Position Transitions | Resume Pro Tips";
const description = "Complete guide to writing a resume for a lateral move within your company. Learn how to frame internal transfers, highlight institutional knowledge, and position yourself for a horizontal career move.";
const canonical = "https://resumeprotips.com/lateral-move-resume-internal-position";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>