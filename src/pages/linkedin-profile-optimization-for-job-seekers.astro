---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/linkedin-profile-optimization-for-job-seekers.html?raw';

const title = "LinkedIn Profile Optimization for Job Seekers -- Headline Formulas, About Section Structure \u0026 SEO Keywords | ResumeProTips";
const description = "Complete LinkedIn profile optimization guide for job seekers. Headline formulas, about section templates, experience bullet formatting, skills strategy, and SEO keyword tactics with before/after examples.";
const canonical = "https://resumeprotips.com/linkedin-profile-optimization-for-job-seekers";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>