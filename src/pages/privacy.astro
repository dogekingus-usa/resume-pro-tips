---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/privacy.html?raw';

const title = "Privacy Policy — Resume Pro Tips";
const description = "Privacy Policy for ResumeProTips. Learn how we collect, use, and protect your personal information.";
const canonical = "https://resumeprotips.com/privacy.html";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
  </div>
</BaseLayout>