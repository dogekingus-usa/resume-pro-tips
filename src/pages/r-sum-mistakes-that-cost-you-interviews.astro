---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/r-sum-mistakes-that-cost-you-interviews.html?raw';

const title = "Resume Mistakes That Cost You Interviews";
const description = "Discover common resume mistakes that can sabotage your job search. Learn how to avoid these errors and increase your chances of landing interviews with Resume Pro Tips.";
const canonical = "https://resumeprotips.com/r-sum-mistakes-that-cost-you-interviews";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>