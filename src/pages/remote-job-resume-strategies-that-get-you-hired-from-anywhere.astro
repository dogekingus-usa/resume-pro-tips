---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/remote-job-resume-strategies-that-get-you-hired-from-anywhere.html?raw';

const title = "Remote Job Resume Strategies That Get You Hired from Anywhere | resumeprotips.com";
const description = "In today\u0027s digital age, remote work has become a norm rather than an exception. As more companies embrace flexibility, securing a remote job can be an exciting";
const canonical = "https://resumeprotips.com/remote-job-resume-strategies-that-get-you-hired-from-anywhere";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>