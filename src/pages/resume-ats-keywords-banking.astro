---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/resume-ats-keywords-banking.html?raw';

const title = "Resume ATS Keywords for Banking \u0026 Finance: Pass the Filter in 2026";
const description = "Essential ATS keywords for banking and finance resumes in 2026. FINRA licenses, Bloomberg Terminal, compliance terms, and role-specific keywords from Analyst to Managing Director. Industry-tested resume formatting tips included.";
const canonical = "https://resumeprotips.com/resume-ats-keywords-banking";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>