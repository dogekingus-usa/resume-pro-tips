---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/resume-font-guide-2026.html?raw';

const title = "Resume Font Guide 2026: Best Fonts, Sizes \u0026 ATS Compatibility";
const description = "Complete resume font guide for 2026. Compare Arial, Calibri, Garamond, Helvetica, Georgia, Lato, Open Sans, and Roboto. ATS compatibility scores, recommended sizes by section, and design principles to make your resume stand out.";
const canonical = "https://resumeprotips.com/resume-font-guide-2026";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>