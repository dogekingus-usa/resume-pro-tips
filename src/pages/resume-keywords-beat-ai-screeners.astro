---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/resume-keywords-beat-ai-screeners.html?raw';

const title = "Resume Keywords That Beat AI Screeners in 2026 | Resume Pro Tips";
const description = "Master the resume keywords that get past AI screening systems in 2026. Industry-specific keyword lists, ATS optimization strategies, and expert tips to double your interview rate.";
const canonical = "https://resumeprotips.com/resume-keywords-beat-ai-screeners";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>