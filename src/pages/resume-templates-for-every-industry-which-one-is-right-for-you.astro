---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/resume-templates-for-every-industry-which-one-is-right-for-you.html?raw';

const title = "Resume Templates for Every Industry: Which One Is Right for You | resumeprotips.com";
const description = "Resume Templates for Every Industry: Which One is Right for You? If you\u0027re looking to land your dream job in a specific industry, choosing the right res";
const canonical = "https://resumeprotips.com/resume-templates-for-every-industry-which-one-is-right-for-you";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>