---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/resume-vs-cover-letter-when-to-use-each-and-how-they-work-together.html?raw';

const title = "Resume vs Cover Letter: When to Use Each and How They Work Together | resumeprotips.com";
const description = "Resume vs Cover Letter: When to Use Each and How They Work Together When ap";
const canonical = "https://resumeprotips.com/resume-vs-cover-letter-when-to-use-each-and-how-they-work-together";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>