---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/resume-writing-for-stay-at-home-parents-returning-to-work.html?raw';

const title = "Resume Writing for Stay-at-Home Parents Returning to Work | resumeprotips.com";
const description = "Introduction Welcome back to the world of work! If you\u0027ve been a stay-at-home parent and are now looking to re-enter the workforce, crafting an effective resume";
const canonical = "https://resumeprotips.com/resume-writing-for-stay-at-home-parents-returning-to-work";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>