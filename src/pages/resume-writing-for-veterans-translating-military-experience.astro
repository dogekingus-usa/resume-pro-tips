---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/resume-writing-for-veterans-translating-military-experience.html?raw';

const title = "Resume Writing for Veterans: Translating Military Experience | resumeprotips.com";
const description = "Introduction to Resume Writing for Veterans Transitioning from military service to civilian life can be challenging, but a well-crafted resume is your key to un";
const canonical = "https://resumeprotips.com/resume-writing-for-veterans-translating-military-experience";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>