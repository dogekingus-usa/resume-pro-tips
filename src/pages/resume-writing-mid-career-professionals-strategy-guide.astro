---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/resume-writing-mid-career-professionals-strategy-guide.html?raw';

const title = "Resume Writing for Mid-Career Professionals: Complete Strategy Guide -- Resume Pro Tips";
const description = "A strategic guide for mid-career professionals to refresh their resume. Learn how to highlight leadership, avoid age bias, and position yourself as a senior contributor.";
const canonical = "https://resumeprotips.com/resume-writing-mid-career-professionals-strategy-guide";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>