---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const cat = 'Resume';
const pageTitle = "Employment Gap on Resume 2026: How to Explain Career Breaks & Get Hired | ResumeProTips.com";
const pageDesc = "Complete guide to handling employment gaps on your resume. Learn formatting strategies, explanation frameworks, and interview tips that turn career breaks into strengths.";
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">{pageTitle}</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded">resume</span>
        <span class="text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded">career-breaks</span>
        <span class="text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded">job-search</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>{pageDesc}</p>
    </div>
  </article>
</BaseLayout>
