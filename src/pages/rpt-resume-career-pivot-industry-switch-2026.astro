---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/rpt-resume-career-pivot-industry-switch-2026.html?raw';

const title = "How to Write a Resume for a Career Pivot: Industry Switch Strategies That Actually Work in 2026";
const description = "Write a career pivot resume that lands interviews in 2026. Transferable skills, hybrid formats, keyword strategies, and salary tips for industry switchers.";
const canonical = "https://resumeprotips.com/rpt-resume-career-pivot-industry-switch-2026";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>