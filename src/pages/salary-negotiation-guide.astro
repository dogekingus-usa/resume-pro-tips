---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/salary-negotiation-guide.html?raw';

const title = "Salary Negotiation Guide: How to Get the Pay You Deserve in 2026 -- Resume Pro Tips";
const description = "Master salary negotiation with proven strategies for job offers, raises, and promotions. Learn what to say, when to say it, and how to maximize your earning potential.";
const canonical = "https://resumeprotips.com/salary-negotiation-guide";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>