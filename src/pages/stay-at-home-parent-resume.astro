---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/stay-at-home-parent-resume.html?raw';

const title = "The Stay-at-Home Parent Resume Guide: How to Return to Work After a Career Break | Resume Pro Tips";
const description = "Complete resume guide for stay-at-home parents returning to work after a career break. Learn how to explain employment gaps, reframe parenting skills, and land interviews.";
const canonical = "https://resumeprotips.com/stay-at-home-parent-resume";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>