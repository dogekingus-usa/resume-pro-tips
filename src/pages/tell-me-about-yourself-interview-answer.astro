---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/tell-me-about-yourself-interview-answer.html?raw';

const title = "How to Answer \u0027Tell Me About Yourself\u0027 in a Job Interview -- Resume Pro Tips";
const description = "Learn how to craft a compelling answer to \u0027Tell me about yourself\u0027 that hooks interviewers. Includes templates, examples, and scripts for any career level.";
const canonical = "https://resumeprotips.com/tell-me-about-yourself-interview-answer";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>