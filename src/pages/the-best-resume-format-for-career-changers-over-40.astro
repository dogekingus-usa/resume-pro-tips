---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/the-best-resume-format-for-career-changers-over-40.html?raw';

const title = "The Best Resume Format for Career Changers Over 40 | resumeprotips.com";
const description = "Changing careers mid-life can be both exciting and challenging, especially when you\u0027re over 40. Your resume is a powerful tool to showcase your skills, experie";
const canonical = "https://resumeprotips.com/the-best-resume-format-for-career-changers-over-40";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>