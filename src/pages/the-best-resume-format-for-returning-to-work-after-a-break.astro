---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/the-best-resume-format-for-returning-to-work-after-a-break.html?raw';

const title = "The Best Resume Format for Returning to Work After a Break | resumeprotips.com";
const description = "Returning to work after taking a break can be challenging, but crafting an effective resume is crucial to making a smooth transition back into your career.";
const canonical = "https://resumeprotips.com/the-best-resume-format-for-returning-to-work-after-a-break";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>