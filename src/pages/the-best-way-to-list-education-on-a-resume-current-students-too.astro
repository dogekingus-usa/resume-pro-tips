---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/the-best-way-to-list-education-on-a-resume-current-students-too.html?raw';

const title = "The Best Way to List Education on a Resume (Current Students Too) | resumeprotips.com";
const description = "The Best Way to List Education on a Resume (Current Students Too) Whether you\u0027re a seasoned professional or just starting your academic journey, listing";
const canonical = "https://resumeprotips.com/the-best-way-to-list-education-on-a-resume-current-students-too";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>