---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/the-best-way-to-structure-a-career-objective-statement.html?raw';

const title = "The Best Way to Structure a Career Objective Statement | resumeprotips.com";
const description = "The Best Way to Structure a Career Objective Statement Creating an effective career objective statement is crucial for any job seeker. A well-crafted";
const canonical = "https://resumeprotips.com/the-best-way-to-structure-a-career-objective-statement";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>