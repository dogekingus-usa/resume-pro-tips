---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/the-best-ways-to-explain-short-term-jobs-on-a-resume.html?raw';

const title = "The Best Ways to Explain Short-Term Jobs on a Resume | resumeprotips.com";
const description = "The Best Ways to Explain Short-Term Jobs on Your Resume When job hopping or working in short-term positions is a part of your career history, it\u0027s impor";
const canonical = "https://resumeprotips.com/the-best-ways-to-explain-short-term-jobs-on-a-resume";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>