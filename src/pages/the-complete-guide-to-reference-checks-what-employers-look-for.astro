---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/the-complete-guide-to-reference-checks-what-employers-look-for.html?raw';

const title = "The Complete Guide to Reference Checks What Employers Look For | ResumeProTips.com";
const description = "Everything you need to know about reference checks in 2026. What employers ask, how to prepare your references, and how to ensure a glowing review.";
const canonical = "https://resumeprotips.com/the-complete-guide-to-reference-checks-what-employers-look-for";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>