---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/the-complete-guide-to-resume-ats-keywords-by-industry-2026.html?raw';

const title = "The Complete Guide to Resume ATS Keywords by Industry 2026 | resumeprotips.com";
const description = "The use of Applicant Tracking Systems (ATS) has become an integral part of the hiring process in many industries today, making it crucial to optimize your resu";
const canonical = "https://resumeprotips.com/the-complete-guide-to-resume-ats-keywords-by-industry-2026";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>