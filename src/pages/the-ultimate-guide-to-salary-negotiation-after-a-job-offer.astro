---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/the-ultimate-guide-to-salary-negotiation-after-a-job-offer.html?raw';

const title = "The Ultimate Guide to Salary Negotiation After a Job Offer | ResumeProTips.com";
const description = "Master salary negotiation after a job offer. Proven scripts, timing strategies, and data-backed tactics to increase your offer by 10-30% in 2026.";
const canonical = "https://resumeprotips.com/the-ultimate-guide-to-salary-negotiation-after-a-job-offer";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>