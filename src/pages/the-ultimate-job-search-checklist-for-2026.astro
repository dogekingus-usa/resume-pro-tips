---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/the-ultimate-job-search-checklist-for-2026.html?raw';

const title = "The Ultimate Job Search Checklist for 2026 | resumeprotips.com";
const description = "Introduction to Your Ultimate Job Search Checklist for 2026 Welcome to your ultimate job search checklist for 2026! Preparing effectively for the job market can";
const canonical = "https://resumeprotips.com/the-ultimate-job-search-checklist-for-2026";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>