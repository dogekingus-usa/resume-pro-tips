---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/top-5-resume-mistakes-career-changers-make-and-how-to-avoid-them.html?raw';

const title = "Top 5 Resume Mistakes Career Changers Make (And How to Avoid Them) | resumeprotips.com";
const description = "Top 5 Resume Mistakes Career Changers Make (And How to Avoid Them) Discover the pitfalls that can harm your career change journey and learn";
const canonical = "https://resumeprotips.com/top-5-resume-mistakes-career-changers-make-and-how-to-avoid-them";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>