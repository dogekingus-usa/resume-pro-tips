---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/top-skills-to-put-on-resume-2026.html?raw';

const title = "Top Skills to Put on Your Resume in 2026 -- Resume Pro Tips";
const description = "Discover the most in-demand skills for 2026 resumes. From AI literacy to data analysis, learn which hard and soft skills employers are actively recruiting for.";
const canonical = "https://resumeprotips.com/top-skills-to-put-on-resume-2026";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>