---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/transferable-skills-resume-guide-2026-identify-showcase-cross-industry-experience.html?raw';

const title = "Transferable Skills Resume Guide 2026: How to Identify \u0026 Showcase Your Cross-Industry Experience | resumeprotips.com";
const description = "Complete guide to identifying and showcasing transferable skills on your resume in 2026. Learn how to leverage cross-industry experience, with examples, templates, and strategies for career changers.";
const canonical = "https://resumeprotips.com/transferable-skills-resume-guide-2026-identify-showcase-cross-industry-experience";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>