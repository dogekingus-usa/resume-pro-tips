---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/ultimate-career-bundle-guide.html?raw';

const title = "The Ultimate Career Bundle: Resumes, Cover Letters, and Job Search Success | ResumeProTips.com";
const description = "The ultimate career bundle combines resume templates, cover letters, LinkedIn optimization, and job search strategies. Get everything you need for career success in one package.";
const canonical = "https://resumeprotips.com/ultimate-career-bundle-guide";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ResumeProTips' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>